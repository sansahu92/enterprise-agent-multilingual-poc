# ── Agent runtime: "agent-framework" (Microsoft Agent Framework on Foundry — case stack, default) or "basic"
AGENT_RUNTIME=agent-framework

# ── Authentication: "entra" (DefaultAzureCredential — production pattern; REQUIRED for the Foundry agent runtime)
#    or "key" (sandbox shortcut for embeddings/Search only)
AUTH_MODE=entra

# ── Microsoft Foundry project (Foundry portal → project Overview → "Project endpoint")
FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<your-project>

# ── Foundry resource's Azure OpenAI endpoint (used for embeddings, and by the 'basic' runtime)
AZURE_OPENAI_ENDPOINT=https://<your-foundry-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=                      # only if AUTH_MODE=key
AZURE_OPENAI_API_VERSION=2024-10-21
CHAT_DEPLOYMENT=<chat-model-deployment-name>   # any tool-calling chat model you deployed
EMBED_DEPLOYMENT=<embedding-deployment-name>   # e.g. a text-embedding-3 deployment
EMBED_DIM=1536                                  # 1536 for -small, 3072 for -large
CHAT_TEMPERATURE=                               # keep empty for gpt-5-mini; set only for models that accept temperature

# ── Azure AI Search
SEARCH_ENDPOINT=https://<your-search>.search.windows.net
SEARCH_API_KEY=                            # only if AUTH_MODE=key (admin key)
SEARCH_INDEX=example-policies-index         # example name; set your own index name locally
SEMANTIC_RANKER=false                      # true if enabled on your Search service
MIN_RERANKER_SCORE=1.0                     # only used when SEMANTIC_RANKER=true
TOP_K=5

# ── Optional: Prompt Shields (Azure AI Content Safety on your Foundry/AI Services resource)
CONTENT_SAFETY_ENDPOINT=                   # e.g. https://<your-foundry-resource>.cognitiveservices.azure.com
CONTENT_SAFETY_KEY=                        # only if AUTH_MODE=key

# ── Optional: Application Insights tracing
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ── Local services
APPROVAL_API_URL=http://127.0.0.1:8000
APPROVED_EMAIL_DOMAINS=authority.gov.ae    # output guard: other e-mail domains are redacted
